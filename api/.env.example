# =============================================================================
# SportFrog - development environment variables
#
# Copy to .env and replace ALL passwords. The .env file is ignored by Git
# and must never be committed.
#
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
# Container superuser. Only creates the database and the roles.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-this-password
POSTGRES_DB=sportfrog
POSTGRES_PORT=5432

# Schema owner. Applies migrations.
SPORTFROG_OWNER_USER=sportfrog_owner
SPORTFROG_OWNER_PASSWORD=change-this-password

# Application roles. Their names are fixed because the migration grants to
# them by name; only their password is set here.
SPORTFROG_APP_PASSWORD=change-this-password
SPORTFROG_PUBLIC_PASSWORD=change-this-password

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=sportfrog
MINIO_ROOT_PASSWORD=change-this-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- API ---------------------------------------------------------------------
# Port of the API container. Only used with --profile full; in the normal
# development flow the API runs from the IDE and doesn't use this value.
API_PORT=8080

# Override what's declared in appsettings.Development.json, which carries no
# passwords. Must match the ones above.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=sportfrog;Username=sportfrog_app;Password=change-this-password
ConnectionStrings__Public=Host=localhost;Port=5432;Database=sportfrog;Username=sportfrog_public;Password=change-this-password
ConnectionStrings__Migrations=Host=localhost;Port=5432;Database=sportfrog;Username=sportfrog_owner;Password=change-this-password

# Used by the EF Core tools when applying migrations by hand.
SPORTFROG_MIGRATIONS_CONNECTION=Host=localhost;Port=5432;Database=sportfrog;Username=sportfrog_owner;Password=change-this-password

# Signing key for access tokens. A secret: never in the repository.
# At least 32 bytes, for HS256.
Authentication__Jwt__SigningKey=change-this-signing-key-at-least-32-bytes
