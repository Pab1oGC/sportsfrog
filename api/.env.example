# =============================================================================
# SportFrog - development environment variables
#
# Copy to .env and replace ALL passwords. The .env file is ignored by Git
# and must never be committed.
#
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
# Container superuser. Only creates the database and the roles.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-this-password
POSTGRES_DB=sportfrog
POSTGRES_PORT=5432

# Schema owner. Applies migrations.
SPORTFROG_OWNER_USER=sportfrog_owner
SPORTFROG_OWNER_PASSWORD=change-this-password

# Application roles. Their names are fixed because the migration grants to
# them by name; only their password is set here.
SPORTFROG_APP_PASSWORD=change-this-password
SPORTFROG_PUBLIC_PASSWORD=change-this-password

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=sportfrog
MINIO_ROOT_PASSWORD=change-this-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- API ---------------------------------------------------------------------
# Port of the API container. Only used with --profile full or --profile
# production; in the normal development flow the API runs from the IDE and
# doesn't use this value.
API_PORT=8080

# Development for --profile full (a quick local look at the API alone, no
# frontend). Production for --profile production, the real deployment.
ASPNETCORE_ENVIRONMENT=Development

# The address a browser uses for the API's signed links (photos, logos,
# credentials), when it isn't the same address the api container itself
# uses (Storage__Endpoint, always "http://minio:9000" — see
# docker-compose.yml). Maps to Storage__PublicUrl.
#
# Empty by default, which is exactly right for --profile full: nothing
# outside the host is meant to reach it, and every link stays what it's
# signed against. --profile production MUST set this to the address the
# public actually uses — a cloudflared tunnel's hostname
# (https://xxxx.trycloudflare.com, or a named tunnel's domain) or a real
# domain behind your own reverse proxy. The API still signs every link
# against minio:9000 internally, then rewrites just the scheme and host to
# this value before handing it out (ObjectStore.Rehost) — the signature
# doesn't cover either, so this is safe. Left empty behind a tunnel, every
# photo, logo and credential comes back broken for anyone outside this
# machine — see web/nginx.conf, which is the other half of this: it reverse-
# proxies /sportfrog/ back to MinIO, forwarding the *internal* host so the
# signature nginx presents to MinIO still matches the one that was signed.
#
# A quick tunnel's hostname changes every time it restarts. Signed links
# expire in 15 minutes (Storage:ReadLinkLifetime), so a stale one only
# matters for that long — but you do need to update this and restart the
# api container whenever the tunnel's address changes.
STORAGE_ENDPOINT=

# What a credential's QR code opens to, verification page appended
# automatically (see DocumentOptions.cs). The default matches what
# appsettings.Development.json already uses for a local `npm run dev`
# frontend. --profile production should override this to the same public
# origin as STORAGE_ENDPOINT, plus "/verificar" — a QR code is printed on
# paper, so a wrong address here is a card nobody can fix after the fact.
VERIFICATION_BASE_URL=http://localhost:5173/verificar

# --- Web (production profile only) -------------------------------------------
# Port the nginx container listens on. Caddy (below) reaches it over the
# Compose network regardless of this value; this is only for hitting the
# site directly by IP:port while there's no domain/DNS pointed here yet.
WEB_PORT=8081

# --- HTTPS (Caddy, production profile only) ----------------------------------
# The domain Caddy requests a Let's Encrypt certificate for and terminates
# TLS on — must already resolve via DNS (an A/AAAA record) to this server's
# public IP before you start this profile, or the certificate request
# fails. Same value that STORAGE_ENDPOINT and VERIFICATION_BASE_URL above
# should be built from (https://this value).
DOMAIN=sportfrog.example.com

# Optional. Only used so Let's Encrypt can email you if a certificate is
# about to fail to renew — Caddy works fine without it.
CADDY_EMAIL=

# Override what's declared in appsettings.Development.json, which carries no
# passwords. Must match the ones above.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=sportfrog;Username=sportfrog_app;Password=change-this-password
ConnectionStrings__Public=Host=localhost;Port=5432;Database=sportfrog;Username=sportfrog_public;Password=change-this-password
ConnectionStrings__Migrations=Host=localhost;Port=5432;Database=sportfrog;Username=sportfrog_owner;Password=change-this-password

# Used by the EF Core tools when applying migrations by hand.
SPORTFROG_MIGRATIONS_CONNECTION=Host=localhost;Port=5432;Database=sportfrog;Username=sportfrog_owner;Password=change-this-password

# Signing key for access tokens. A secret: never in the repository.
# At least 32 bytes, for HS256.
Authentication__Jwt__SigningKey=change-this-signing-key-at-least-32-bytes

# --- Platform account ---------------------------------------------------------
# The one account allowed to register new organizations (POST /organizations
# is no longer anonymous — see PlatformAuthority and the SeedPlatformOwner
# migration, which reads exactly these two on a fresh database and seeds
# Frogtech Solutions, the organization SportFrog itself operates under, with
# this account holding Owner there). No default: change the password before
# this runs against anything other than a throwaway local database.
PLATFORM_ADMIN_EMAIL=owner@frogtech-solutions.example
PLATFORM_ADMIN_PASSWORD=change-this-password-too

# --- SMTP (outgoing email) ----------------------------------------------------
# Optional. Blank Host means "not configured" — the API runs fine without it,
# it just logs instead of sending (e.g. match/performance reschedule notices).
#
# Example below is for Gmail: Username = your full @gmail.com address,
# Password = a 16-char Google App Password
# (https://myaccount.google.com/apppasswords) — requires 2-Step Verification
# enabled first; Gmail rejects a normal account password over SMTP.
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=your-address@gmail.com
Smtp__Password=change-this-app-password
Smtp__UseStartTls=true
Smtp__FromAddress=your-address@gmail.com
Smtp__FromName=SportFrog

# Validador de fotos (docker-compose.validador.yml). Puerto publicado en 127.0.0.1.
VALIDADOR_PORT=8100
# La API NO lee este archivo para la URL del validador: la toma del entorno del
# proceso. Con dotnet run, setear antes de arrancar:
Validador__Url=http://localhost:8100
