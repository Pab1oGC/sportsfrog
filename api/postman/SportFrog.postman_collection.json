      "item": [
        {
          "name": "Crear competencia",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('competitionId', pm.response.json().id);",
