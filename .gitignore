dist/
*.tsbuildinfo

# Output of `tsc -b`: tsconfig.node.json compiles vite.config.ts and emits
# these beside it. Two Vite configs with the same content is a trap — an edit
# to the .ts is silently ignored if the .js is the one that gets picked up.
frontend/vite.config.js
frontend/vite.config.d.ts

